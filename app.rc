// Template: build.rs fills in @ICON@ and the version placeholders from
// Cargo.toml, so the release version CI stamps there reaches the .exe.

1 ICON "@ICON@"

// Task Manager and the taskbar show FileDescription; without it they fall
// back to the file name, "ds-buddy.exe".
1 VERSIONINFO
FILEVERSION @VERSION_COMMAS@
PRODUCTVERSION @VERSION_COMMAS@
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "DS Buddy"
            VALUE "ProductName", "DS Buddy"
            VALUE "FileVersion", "@VERSION@"
            VALUE "ProductVersion", "@VERSION@"
            VALUE "OriginalFilename", "ds-buddy.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
